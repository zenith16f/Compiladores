<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="automaton.ui.CerradurasController"
      spacing="16" styleClass="panel-catalogo">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Cerraduras (Kleene / Positiva)" styleClass="titulo"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Aplicar operación a:"/>
        <ComboBox fx:id="comboAfn" promptText="AFN" prefWidth="180"/>
        <ComboBox fx:id="comboOperacion" prefWidth="220"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Nombre del resultado:"/>
        <TextField fx:id="campoNombreResultado" promptText="opcional" prefWidth="180"/>
        <Button text="Realizar operación" onAction="#onRealizarOperacion" styleClass="boton-primario"/>
    </HBox>

</VBox>
