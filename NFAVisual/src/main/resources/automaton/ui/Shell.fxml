<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="automaton.ui.ShellController"
            styleClass="raiz">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="barra-nav-contenedor">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>

            <!-- Colapsado: solo el boton hamburguesa. -->
            <StackPane fx:id="contenedorBurger">
                <Button fx:id="botonBurger" onAction="#onToggleMenu" styleClass="boton-burger">
                    <graphic>
                        <VBox spacing="4" alignment="CENTER">
                            <Region styleClass="raya-burger"/>
                            <Region styleClass="raya-burger"/>
                            <Region styleClass="raya-burger"/>
                        </VBox>
                    </graphic>
                </Button>
            </StackPane>

            <!-- Expandido: pastilla oscura horizontal con las opciones, estilo OpenMenu. -->
            <HBox fx:id="pillNav" alignment="CENTER_LEFT" spacing="2" styleClass="pill-nav"
                  visible="false" managed="false">
                <Button fx:id="botonNavAfn" text="&#8962; AFN" onAction="#onNavAfn" styleClass="boton-nav-pill"/>
                <Button fx:id="botonNavConvertirAfd" text="AFN &#8594; AFD" onAction="#onNavConvertirAfd" styleClass="boton-nav-pill"/>
                <Button fx:id="botonNavUnirLexico" text="&#955; Unir para Lexico" onAction="#onNavUnirLexico" styleClass="boton-nav-pill"/>
                <Button fx:id="botonCerrarPill" text="&#10005;" onAction="#onToggleMenu" styleClass="boton-cerrar-pill"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="areaContenido"/>
    </center>

</BorderPane>
