<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="automaton.ui.ListadoAFDController"
      spacing="8" styleClass="panel-catalogo">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="AFD guardados" styleClass="titulo"/>
    <ListView fx:id="listaAfd" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="No hay AFD guardados. Conviértelos desde la pestaña «AFN → AFD»." styleClass="subtitulo"/>
        </placeholder>
    </ListView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="campoNuevoNombre" promptText="Nuevo nombre" prefWidth="220"/>
        <Button text="Renombrar seleccionado" onAction="#onRenombrar" styleClass="boton-secundario"/>
        <Button text="Eliminar seleccionado" onAction="#onEliminar" styleClass="boton-secundario"/>
        <Button text="imprimir" onAction="#onImprimir" styleClass="boton-secundario"/>
    </HBox>
</VBox>
