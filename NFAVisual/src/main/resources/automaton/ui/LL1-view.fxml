<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="automaton.ui.LL1Controller"
            styleClass="raiz">

    <top>
        <VBox spacing="4" styleClass="barra-superior">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label text="Tabla LL(1)" styleClass="titulo"/>
            <Label text="Escribe la gramática (sin recursión por la izquierda), genera la tabla y analiza una cadena σ."
                   styleClass="subtitulo" wrapText="true"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.33" orientation="HORIZONTAL" styleClass="split-ver-afn">
            <items>
                <!-- Izquierda: la gramatica -->
                <VBox spacing="8" styleClass="panel-catalogo" minWidth="240">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <Label text="Gramática" styleClass="subtitulo"/>
                    <TextArea fx:id="areaGramatica" VBox.vgrow="ALWAYS" styleClass="area-cadena"
                              promptText="E -> T E' ;&#10;E' -> + T E' | - T E' | epsilon ;&#10;..."/>
                    <Label text="Formato:  A -> x y z | w | epsilon ;   (símbolos separados por espacios)"
                           styleClass="texto-ayuda" wrapText="true"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button text="Generar tabla LL(1)" onAction="#onGenerar" styleClass="boton-primario"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button text="Ejemplo de clase" onAction="#onEjemplo" styleClass="boton-secundario"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Abrir archivo…" onAction="#onAbrirArchivo" styleClass="boton-secundario"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="etiquetaEstadoTabla" text="Sin tabla generada" styleClass="estado-afd-pendiente"
                           wrapText="true"/>
                </VBox>

                <!-- Derecha: resultados -->
                <TabPane fx:id="pestanas" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-afn">
                    <tabs>
                        <Tab text="Reglas">
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>
                                <Label text="Arreglo de reglas (el índice es el Id de la regla)" styleClass="subtitulo"/>
                                <TableView fx:id="tablaReglas" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colReglaId" text="Id" sortable="false" maxWidth="70" minWidth="50"/>
                                        <TableColumn fx:id="colReglaIzq" text="Lado izquierdo" sortable="false"/>
                                        <TableColumn fx:id="colReglaDer" text="Lado derecho (lista)" sortable="false"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="Genera la tabla para ver las reglas" styleClass="subtitulo"/>
                                    </placeholder>
                                </TableView>
                            </VBox>
                        </Tab>

                        <Tab text="First y Follow">
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>
                                <Label text="Conjuntos de cada no terminal" styleClass="subtitulo"/>
                                <TableView fx:id="tablaFirstFollow" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colFfSimbolo" text="No terminal" sortable="false" maxWidth="120" minWidth="80"/>
                                        <TableColumn fx:id="colFfFirst" text="First" sortable="false"/>
                                        <TableColumn fx:id="colFfFollow" text="Follow" sortable="false"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="Genera la tabla para ver First y Follow" styleClass="subtitulo"/>
                                    </placeholder>
                                </TableView>
                            </VBox>
                        </Tab>

                        <Tab text="Tabla LL(1)">
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>
                                <Label text="Tabla[no terminal][terminal] = Id de la regla  (vacío = error)"
                                       styleClass="subtitulo"/>
                                <TableView fx:id="tablaLL1" VBox.vgrow="ALWAYS">
                                    <placeholder>
                                        <Label text="Genera la tabla LL(1)" styleClass="subtitulo"/>
                                    </placeholder>
                                </TableView>
                                <Label fx:id="etiquetaConflictos" wrapText="true" styleClass="texto-error"/>
                            </VBox>
                        </Tab>

                        <Tab text="Analizar σ">
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>

                                <HBox spacing="12" VBox.vgrow="NEVER">
                                    <VBox spacing="6" HBox.hgrow="NEVER" prefWidth="210">
                                        <Label text="Token de cada terminal" styleClass="subtitulo"/>
                                        <TableView fx:id="tablaTerminales" editable="true" prefHeight="150">
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                            </columnResizePolicy>
                                            <columns>
                                                <TableColumn fx:id="colTermSimbolo" text="Terminal" sortable="false"/>
                                                <TableColumn fx:id="colTermToken" text="Token ✎" sortable="false"/>
                                            </columns>
                                            <placeholder>
                                                <Label text="Sin terminales" styleClass="subtitulo"/>
                                            </placeholder>
                                        </TableView>
                                    </VBox>
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Analizador léxico para σ" styleClass="subtitulo"/>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Button text="Cargar AFD…" onAction="#onCargarAfd" styleClass="boton-secundario"/>
                                            <Button text="Quitar AFD" onAction="#onQuitarAfd" styleClass="boton-secundario"/>
                                        </HBox>
                                        <Label fx:id="etiquetaLexico" wrapText="true" styleClass="estado-afd-pendiente"
                                               text="Sin AFD: σ se escribe con los nombres de los terminales (ej. num+num*(num))"/>
                                        <Label text="Cadena σ" styleClass="subtitulo"/>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <TextField fx:id="campoSigma" HBox.hgrow="ALWAYS" styleClass="area-cadena"
                                                       promptText="ej. num+num*(num-num)" onAction="#onAnalizar"/>
                                            <Button text="Analizar" onAction="#onAnalizar" styleClass="boton-primario"/>
                                        </HBox>
                                        <Label fx:id="etiquetaResultado" wrapText="true" styleClass="estado-afd-pendiente"/>
                                    </VBox>
                                </HBox>

                                <TableView fx:id="tablaPasos" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colPasoNum" text="#" sortable="false" maxWidth="50" minWidth="40"/>
                                        <TableColumn fx:id="colPasoPila" text="Pila" sortable="false" styleClass="columna-izquierda"/>
                                        <TableColumn fx:id="colPasoCadena" text="Cadena" sortable="false" styleClass="columna-derecha"/>
                                        <TableColumn fx:id="colPasoAccion" text="Acción" sortable="false" styleClass="columna-izquierda"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="Escribe σ y presiona Analizar" styleClass="subtitulo"/>
                                    </placeholder>
                                </TableView>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </items>
        </SplitPane>
    </center>
</BorderPane>
