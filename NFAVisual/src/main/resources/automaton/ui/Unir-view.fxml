<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="automaton.ui.UnirController"
      spacing="14" styleClass="panel-catalogo">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <fx:define>
        <ToggleGroup fx:id="modoUnir"/>
    </fx:define>

    <Label text="Unir AFN" styleClass="titulo"/>

    <HBox spacing="4" styleClass="contenedor-segmento">
        <ToggleButton fx:id="toggleUnirDos" text="Unir 2" toggleGroup="$modoUnir" selected="true"
                      onAction="#onCambiarModo" styleClass="boton-segmento"/>
        <ToggleButton fx:id="toggleUnirVarios" text="Unir varios" toggleGroup="$modoUnir"
                      onAction="#onCambiarModo" styleClass="boton-segmento"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">

        <!-- Modo "Unir 2": el flujo original con dos combos. -->
        <VBox fx:id="panelUnirDos" spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="AFN a unir:"/>
                <ComboBox fx:id="comboAfnUno" promptText="AFN 1" prefWidth="180"/>
                <ComboBox fx:id="comboAfnDos" promptText="AFN 2" prefWidth="180"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Nombre del resultado:"/>
                <TextField fx:id="campoNombreResultadoDos" promptText="opcional" prefWidth="180"/>
                <TextField fx:id="campoTokenDos" promptText="token (opcional)" prefWidth="130"/>
                <Button text="Unir" onAction="#onUnirDos" styleClass="boton-primario"/>
            </HBox>
        </VBox>

        <!-- Modo "Unir varios" (Union especial): nuevo estado inicial con epsilon a cada
             AFN marcado; cada AFN conserva sus estados de aceptacion con su token. -->
        <VBox fx:id="panelUnirVarios" spacing="12" visible="false" managed="false">
            <Label text="Marca los AFN a unir y asigna el token de cada uno. Cada AFN conserva sus estados de aceptación con su token (el orden de la lista es la prioridad)."
                   styleClass="subtitulo" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Nombre del resultado:"/>
                <TextField fx:id="campoNombreResultadoVarios" promptText="opcional" prefWidth="180"/>
                <Button text="Unir seleccionados" onAction="#onUnirVarios" styleClass="boton-primario"/>
            </HBox>
            <TableView fx:id="tablaAfnUnir" editable="true" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="columnaSeleccion" text="✓" prefWidth="50" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="columnaNombre" text="AFN" prefWidth="220" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="columnaToken" text="Token" prefWidth="120" sortable="false" reorderable="false"/>
                </columns>
                <placeholder>
                    <Label text="No hay AFN en el catálogo."/>
                </placeholder>
            </TableView>
        </VBox>

    </StackPane>

</VBox>
