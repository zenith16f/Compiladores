<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>

<!--
  Contenedor de todo lo relacionado con AFD: por ahora solo el listado
  (placeholder, sin guardado todavia) y la conversion AFN -> AFD. Mismo
  patron que AfnHub-view.fxml: cada pestaña carga una vista existente
  via fx:include, y JavaFX inyecta el controlador de cada include en
  AfdHubController usando "<fx:id>Controller" (ver AfdHubController.java).
-->
<TabPane xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="automaton.ui.AfdHubController"
         tabClosingPolicy="UNAVAILABLE"
         styleClass="tabs-afn">
    <tabs>
        <Tab text="Listado">
            <fx:include source="ListadoAFD-view.fxml"/>
        </Tab>
        <Tab text="AFN → AFD">
            <fx:include fx:id="convertir" source="ConvertirAFD-view.fxml"/>
        </Tab>
    </tabs>
</TabPane>
