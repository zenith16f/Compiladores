<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="automaton.ui.DescensoRecursivoController"
            styleClass="raiz">

    <top>
        <VBox spacing="4" styleClass="barra-superior">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label text="Descenso Recursivo" styleClass="titulo"/>
            <Label text="Escribe la gramática (sin recursión por la izquierda), genera las funciones recursivas y analiza una cadena σ (sincronizada con AFD o en crudo)."
                   styleClass="subtitulo" wrapText="true"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.33" orientation="HORIZONTAL" styleClass="split-ver-afn">
            <items>
                <!-- Izquierda: la gramatica -->
                <VBox spacing="8" styleClass="panel-catalogo" minWidth="240">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <Label text="Gramática" styleClass="subtitulo"/>
                    <TextArea fx:id="areaGramatica" VBox.vgrow="ALWAYS" styleClass="area-cadena"
                              promptText="E -> T E' ;&#10;E' -> + T E' | - T E' | epsilon ;&#10;..."/>
                    <Label text="Formato:  A -> x y z | w | epsilon ;   (símbolos separados por espacios)"
                           styleClass="texto-ayuda" wrapText="true"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button text="Generar Descenso Recursivo" onAction="#onGenerar" styleClass="boton-primario"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button text="Ejemplo de clase" onAction="#onEjemplo" styleClass="boton-secundario"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Abrir archivo…" onAction="#onAbrirArchivo" styleClass="boton-secundario"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="etiquetaEstadoAnalizador" text="Sin analizador generado" styleClass="estado-afd-pendiente"
                           wrapText="true"/>
                </VBox>

                <!-- Derecha: resultados -->
                <TabPane fx:id="pestanas" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-afn">
                    <tabs>
                        <Tab text="Reglas y First">
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>
                                <Label text="Reglas de producción y conjunto First(α) de decisión para cada función recursiva"
                                       styleClass="subtitulo"/>
                                <TableView fx:id="tablaReglas" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colReglaId" text="Id" sortable="false" maxWidth="60" minWidth="45"/>
                                        <TableColumn fx:id="colReglaIzq" text="Función (No terminal)" sortable="false" maxWidth="160" minWidth="110"/>
                                        <TableColumn fx:id="colReglaDer" text="Lado derecho (α)" sortable="false"/>
                                        <TableColumn fx:id="colReglaFirst" text="First(α) [Lookahead]" sortable="false"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="Genera el analizador para ver las reglas y conjuntos First" styleClass="subtitulo"/>
                                    </placeholder>
                                </TableView>
                            </VBox>
                        </Tab>

                        <Tab text="Funciones Recursivas">
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>
                                <Label text="Estructura de procedimientos recursivos generados (1 función por cada No Terminal + undoToken en ε)"
                                       styleClass="subtitulo"/>
                                <TextArea fx:id="areaPseudocodigo" VBox.vgrow="ALWAYS" editable="false"
                                          styleClass="area-cadena"
                                          promptText="Genera el descenso recursivo para visualizar el código de las funciones..."/>
                            </VBox>
                        </Tab>

                        <Tab text="Analizar σ">
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>

                                <HBox spacing="12" VBox.vgrow="NEVER">
                                    <VBox spacing="6" HBox.hgrow="NEVER" prefWidth="215">
                                        <Label text="Token de cada terminal" styleClass="subtitulo"/>
                                        <TableView fx:id="tablaTerminales" editable="true" prefHeight="155">
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                            </columnResizePolicy>
                                            <columns>
                                                <TableColumn fx:id="colTermSimbolo" text="Terminal" sortable="false"/>
                                                <TableColumn fx:id="colTermToken" text="Token ✎" sortable="false"/>
                                            </columns>
                                            <placeholder>
                                                <Label text="Sin terminales" styleClass="subtitulo"/>
                                            </placeholder>
                                        </TableView>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Analizador léxico y sincronización con AFD" styleClass="subtitulo"/>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Button text="Cargar AFD…" onAction="#onCargarAfd" styleClass="boton-secundario"/>
                                            <Button text="Sincronizar tokens estándar" onAction="#onSincronizarTokens" styleClass="boton-secundario"/>
                                            <Button text="Quitar AFD (Modo crudo)" onAction="#onQuitarAfd" styleClass="boton-secundario"/>
                                        </HBox>
                                        <Label fx:id="etiquetaLexico" wrapText="true" styleClass="estado-afd-pendiente"
                                               text="Sin AFD (Modo crudo): σ se escribe directamente con los terminales (ej. num + num * ( num ))"/>
                                        <Label text="Cadena σ en crudo" styleClass="subtitulo"/>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <TextField fx:id="campoSigma" HBox.hgrow="ALWAYS" styleClass="area-cadena"
                                                       promptText="ej. num + num * ( num - num )   ó   con AFD: 25 + 3 * ( 10 - 4 )"
                                                       onAction="#onAnalizar"/>
                                            <Button text="Analizar" onAction="#onAnalizar" styleClass="boton-primario"/>
                                        </HBox>
                                        <Label fx:id="etiquetaResultado" wrapText="true" styleClass="estado-afd-pendiente"/>
                                    </VBox>
                                </HBox>

                                <SplitPane dividerPositions="0.68" orientation="HORIZONTAL" VBox.vgrow="ALWAYS">
                                    <items>
                                        <TableView fx:id="tablaPasos">
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                            </columnResizePolicy>
                                            <columns>
                                                <TableColumn fx:id="colPasoNum" text="#" sortable="false" maxWidth="50" minWidth="40"/>
                                                <TableColumn fx:id="colPasoFuncion" text="Función Activa" sortable="false" styleClass="columna-izquierda"/>
                                                <TableColumn fx:id="colPasoRegla" text="Regla / Match" sortable="false" styleClass="columna-izquierda"/>
                                                <TableColumn fx:id="colPasoToken" text="Lookahead (Token)" sortable="false" styleClass="columna-izquierda"/>
                                                <TableColumn fx:id="colPasoCadena" text="Cadena Restante" sortable="false" styleClass="columna-derecha"/>
                                                <TableColumn fx:id="colPasoAccion" text="Acción" sortable="false" styleClass="columna-izquierda"/>
                                            </columns>
                                            <placeholder>
                                                <Label text="Escribe una cadena σ y presiona Analizar" styleClass="subtitulo"/>
                                            </placeholder>
                                        </TableView>

                                        <VBox spacing="4">
                                            <Label text="Árbol de llamadas recursivas" styleClass="subtitulo"/>
                                            <TextArea fx:id="areaArbolGramatica" VBox.vgrow="ALWAYS" editable="false"
                                                      styleClass="area-cadena"
                                                      promptText="Aquí se mostrará la traza jerárquica de llamadas recursivas..."/>
                                        </VBox>
                                    </items>
                                </SplitPane>
                            </VBox>
                        </Tab>

                        <Tab text="Calculadora Aritmética (Directa)">
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="12" right="12" bottom="12" left="12"/>
                                </padding>
                                <Label text="Evaluador directo por Descenso Recursivo (DescRecCalculadora) con atributos sintetizados (valor v y notación postfija)"
                                       styleClass="subtitulo" wrapText="true"/>

                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Expresión aritmética en crudo:" styleClass="subtitulo"/>
                                    <TextField fx:id="campoExpresionCalc" HBox.hgrow="ALWAYS" styleClass="area-cadena"
                                               promptText="ej. (2 + 3) * 4 - 10 / 2" onAction="#onEvaluarCalculadora"/>
                                    <Button text="Evaluar expresión" onAction="#onEvaluarCalculadora" styleClass="boton-primario"/>
                                    <Button text="Cargar AFD en Calculadora…" onAction="#onCargarAfdCalculadora" styleClass="boton-secundario"/>
                                    <Button text="Léxico interno" onAction="#onUsarLexicoInternoCalc" styleClass="boton-secundario"/>
                                </HBox>

                                <HBox spacing="16" alignment="CENTER_LEFT">
                                    <Label fx:id="etiquetaLexicoCalc" text="Léxico activo: LexicoCalculadora interno (Tokens: +=10, -=20, *=30, /=40, (=50, )=60, NUM=70)"
                                           styleClass="estado-afd-pendiente" wrapText="true"/>
                                </HBox>

                                <HBox spacing="16" alignment="CENTER_LEFT">
                                    <Label fx:id="etiquetaResultadoCalc" text="Ingresa una expresión y presiona Evaluar"
                                           styleClass="estado-afd-pendiente" wrapText="true"/>
                                    <Label fx:id="etiquetaValorCalc" text="" styleClass="titulo"/>
                                    <Label fx:id="etiquetaPostfijoCalc" text="" styleClass="subtitulo"/>
                                </HBox>

                                <SplitPane dividerPositions="0.65" orientation="HORIZONTAL" VBox.vgrow="ALWAYS">
                                    <items>
                                        <TableView fx:id="tablaPasosCalc">
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                            </columnResizePolicy>
                                            <columns>
                                                <TableColumn fx:id="colCalcPaso" text="#" sortable="false" maxWidth="50" minWidth="40"/>
                                                <TableColumn fx:id="colCalcFuncion" text="Función" sortable="false" maxWidth="120" minWidth="80"/>
                                                <TableColumn fx:id="colCalcDetalle" text="Detalle" sortable="false" styleClass="columna-izquierda"/>
                                                <TableColumn fx:id="colCalcToken" text="Token" sortable="false" maxWidth="130" minWidth="90"/>
                                                <TableColumn fx:id="colCalcAtributos" text="Atributos (v, post)" sortable="false" styleClass="columna-izquierda"/>
                                            </columns>
                                            <placeholder>
                                                <Label text="Evalúa una expresión para ver los pasos del descenso recursivo" styleClass="subtitulo"/>
                                            </placeholder>
                                        </TableView>

                                        <VBox spacing="4">
                                            <Label text="Árbol de llamadas y síntesis" styleClass="subtitulo"/>
                                            <TextArea fx:id="areaArbolCalc" VBox.vgrow="ALWAYS" editable="false"
                                                      styleClass="area-cadena"/>
                                        </VBox>
                                    </items>
                                </SplitPane>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </items>
        </SplitPane>
    </center>
</BorderPane>
